{
  "name": "sintbot",
  "version": "1.0.15",
  "description": "Drive headless Claude Code (or Codex) from Slack / Feishu / WeCom group chats — one group, one project, swappable model brain. A standalone daemon, not a Claude Code plugin.",
  "bin": {
    "sbot": "bin/sbot.js",
    "sintbot": "bin/sbot.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "CHANGELOG.json",
    "CHANGELOG.en.json",
    "sbot.config.example.json",
    "README.md",
    "README.zh-CN.md",
    "docs/install.md",
    "docs/AI-ASSISTED-INSTALL.md",
    "docs/zh-CN/install.md",
    "docs/zh-CN/AI-ASSISTED-INSTALL.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "docs/slack-app-manifest.yaml"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/sbot.js",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "test:redact": "node --test tests/unit/redact.test.js",
    "test:store": "node --test tests/unit/store.test.js",
    "test:config": "node --test tests/unit/config.test.js",
    "test:engine": "node --test tests/unit/engine.test.js",
    "test:agent": "node --test tests/unit/agent.test.js",
    "test:health": "node --test tests/unit/health.test.js",
    "test:visionproxy": "node --test tests/unit/visionproxy.test.js"
  },
  "keywords": [
    "claude-code",
    "codex",
    "feishu",
    "slack",
    "wecom",
    "group-chat",
    "chatops",
    "ai-agent",
    "deepseek",
    "self-hosted",
    "daemon"
  ],
  "author": "WaterTian",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://sintbot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sintlab/sintbot.git"
  },
  "bugs": {
    "url": "https://github.com/sintlab/sintbot/issues"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "ws": "^8.21.3"
  }
}
